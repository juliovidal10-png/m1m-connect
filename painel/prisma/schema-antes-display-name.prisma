generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model M1MCompany {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     M1MUser[]
  customers M1MCustomer[]
  reminders M1MReminder[]

  @@map("m1m_companies")
}

model M1MUser {
  id        String   @id @default(cuid())
  companyId String
  name      String
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company M1MCompany @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("m1m_users")
}

model M1MCustomer {
  id           String   @id @default(cuid())
  companyId    String
  remoteJid    String   @unique
  name         String?
  phone        String?
  company      String?
  city         String?
  responsible  String?
  observations String?
  status       String?  @default("IA")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner     M1MCompany  @relation(fields: [companyId], references: [id])
  reminders M1MReminder[]

  @@index([companyId])
  @@index([remoteJid])
  @@map("m1m_customers")
}

model M1MReminder {
  id          String    @id @default(cuid())
  companyId   String
  customerId  String
  title       String
  description String?
  remindAt    DateTime
  responsible String?
  status      String    @default("PENDING")
  completedAt DateTime?
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company  M1MCompany  @relation(fields: [companyId], references: [id])
  customer M1MCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([customerId])
  @@index([remindAt])
  @@index([status])
  @@map("m1m_reminders")
}