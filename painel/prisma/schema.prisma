generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum M1MSubscriptionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum M1MBillingCycle {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum M1MSubscriptionEventType {
  ACTIVATION
  RENEWAL
}

enum M1MHumanReturnMode {
  IMMEDIATE
  NEXT_CONVERSATION
  MANUAL
}

enum M1MAttendanceState {
  IA
  HUMANO
  FINALIZADO
}

enum M1MAttendanceEventType {
  STARTED_BY_AI
  TRANSFERRED_TO_SECTOR
  TAKEN_BY_HUMAN
  FINISHED_BY_HUMAN
  FINISHED_BY_AI
}

enum M1MAttendanceActorType {
  AI
  USER
  SYSTEM
}

enum M1MMessageDirection {
  IN
  OUT
}

enum M1MMessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  LOCATION
  CONTACT
  STICKER
  REACTION
  UNKNOWN
}

enum M1MMessageFlagType {
  FAVORITE
  PINNED
}

enum M1MPaymentReceiptStatus {
  RECEIVED
  CLASSIFIED
  UNDER_REVIEW
  APPROVED
  REJECTED
  AWAITING_NEW_RECEIPT
  CUSTOMER_NOTIFIED
  FINISHED
}

enum M1MPaymentReceiptEventType {
  RECEIVED
  CLASSIFIED
  REVIEW_STARTED
  APPROVED
  REJECTED
  AWAITING_NEW_RECEIPT
  CUSTOMER_NOTIFIED
  FINISHED
  NOTE_ADDED
}

model M1MCompany {
  id                     String                @id @default(cuid())
  name                   String
  slug                   String                @unique
  segment                String?
  presentation           String?
  address                String?
  city                   String?
  state                  String?
  zipCode                String?
  phone                  String?
  whatsapp               String?
  email                  String?
  website                String?
  instagram              String?
  outOfHoursMessage      String?
  humanReturnMode        M1MHumanReturnMode    @default(NEXT_CONVERSATION)
  humanClosingMessage    String?
  active                 Boolean               @default(true)
  subscriptionStatus     M1MSubscriptionStatus @default(TRIAL)
  trialEndsAt            DateTime?
  accessEndsAt           DateTime?
  planName               String?
  subscriptionPriceCents Int?
  billingCycle           M1MBillingCycle?
  subscriptionStartedAt  DateTime?
  onboardingCompleted    Boolean               @default(false)
  aiEnabled              Boolean               @default(false)
  whatsappInstanceName   String?               @unique
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  users        M1MUser[]
  customers    M1MCustomer[]
  reminders    M1MReminder[]
  attendances  M1MAttendance[]
  messages     M1MMessage[]
  messageFlags M1MMessageFlag[]

  schedules       M1MCompanySchedule[]
  sectors         M1MSector[]
  profile         M1MCompanyProfile?
  paymentSettings M1MPaymentSettings?
  paymentReceipts M1MPaymentReceipt[]

  subscriptionEvents M1MSubscriptionEvent[]

  subscriptionPayments M1MSubscriptionPayment[]

  @@map("m1m_companies")
}

model M1MCompanyProfile {
  id                       String   @id @default(cuid())
  companyId                String   @unique
  presentation             String?
  differentials            String?
  productsServices         String?
  targetAudience           String?
  serviceArea              String?
  companyPolicies          String?
  importantInformation     String?
  frequentlyAskedQuestions String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  company M1MCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("m1m_company_profiles")
}

model M1MPaymentSettings {
  id                    String   @id @default(cuid())
  companyId             String   @unique
  acceptsPix            Boolean  @default(false)
  acceptsCash           Boolean  @default(false)
  acceptsCreditCard     Boolean  @default(false)
  acceptsDebitCard      Boolean  @default(false)
  acceptsBankSlip       Boolean  @default(false)
  acceptsBankTransfer   Boolean  @default(false)
  pixKeyType            String?
  pixKey                String?
  pixHolderName         String?
  pixHolderDocument     String?
  bankName              String?
  bankAgency            String?
  bankAccount           String?
  bankAccountType       String?
  maxInstallments       Int?
  installmentInterest   String?
  paymentDeadline       String?
  receiptInstructions   String?
  billingRules          String?
  additionalInformation String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  company M1MCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("m1m_payment_settings")
}

model M1MSector {
  id                         String   @id @default(cuid())
  companyId                  String
  name                       String
  description                String?
  knowledge                  String?
  useCustomSchedule          Boolean  @default(false)
  useCustomOutOfHoursMessage Boolean  @default(false)
  outOfHoursMessage          String?
  active                     Boolean  @default(true)
  sortOrder                  Int      @default(0)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  company     M1MCompany          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sectorUsers M1MSectorUser[]
  schedules   M1MSectorSchedule[]
  attendances M1MAttendance[]
  keywords    M1MSectorKeyword[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([companyId, active])
  @@index([companyId, sortOrder])
  @@map("m1m_sectors")
}

model M1MSectorKeyword {
  id        String   @id @default(cuid())
  sectorId  String
  keyword   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sector M1MSector @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@unique([sectorId, keyword])
  @@index([sectorId])
  @@index([keyword])
  @@map("m1m_sector_keywords")
}

enum M1MWeekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model M1MCompanySchedule {
  id                String     @id @default(cuid())
  companyId         String
  dayOfWeek         M1MWeekday
  enabled           Boolean    @default(false)
  allDay            Boolean    @default(false)
  openingTime       String?
  closingTime       String?
  secondOpeningTime String?
  secondClosingTime String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  company M1MCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, dayOfWeek])
  @@index([companyId])
  @@index([companyId, enabled])
  @@map("m1m_company_schedules")
}

model M1MSectorSchedule {
  id                String     @id @default(cuid())
  sectorId          String
  dayOfWeek         M1MWeekday
  enabled           Boolean    @default(false)
  allDay            Boolean    @default(false)
  openingTime       String?
  closingTime       String?
  secondOpeningTime String?
  secondClosingTime String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  sector M1MSector @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@unique([sectorId, dayOfWeek])
  @@index([sectorId])
  @@index([sectorId, enabled])
  @@map("m1m_sector_schedules")
}

enum M1MUserPermission {
  VIEW_ALL_CONVERSATIONS
  ASSUME_ATTENDANCE
  TRANSFER_ATTENDANCE
  CLOSE_ATTENDANCE
  EDIT_CRM
  VIEW_RECEIPTS
  DELETE_CUSTOMERS
  DELETE_MESSAGES
  MANAGE_USERS
  MANAGE_SECTORS
  MANAGE_HOURS
  MANAGE_AI
  MANAGE_KNOWLEDGE
  ACCESS_SETTINGS
}

enum M1MUserRole {
  ADMIN
  MANAGER
  ATTENDANT
  FINANCE
}

model M1MUser {
  id                   String              @id @default(cuid())
  companyId            String
  name                 String
  displayName          String?
  email                String              @unique
  passwordHash         String?
  jobTitle             String?
  phone                String?
  role                 M1MUserRole         @default(ATTENDANT)
  useCustomPermissions Boolean             @default(false)
  permissions          M1MUserPermission[] @default([])
  active               Boolean             @default(true)
  isPrimary            Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  company              M1MCompany               @relation(fields: [companyId], references: [id])
  assignedCustomers    M1MCustomer[]            @relation("AssignedCustomerUser")
  assignedAttendances  M1MAttendance[]          @relation("AttendanceResponsible")
  attendanceEvents     M1MAttendanceEvent[]     @relation("AttendanceEventActor")
  sectorUsers          M1MSectorUser[]
  paymentReceipts      M1MPaymentReceipt[]      @relation("PaymentReceiptResponsible")
  paymentReceiptEvents M1MPaymentReceiptEvent[] @relation("PaymentReceiptEventActor")

  @@index([companyId])
  @@map("m1m_users")
}

model M1MSectorUser {
  id        String   @id @default(cuid())
  sectorId  String
  userId    String
  createdAt DateTime @default(now())

  sector M1MSector @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  user   M1MUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sectorId, userId])
  @@index([sectorId])
  @@index([userId])
  @@map("m1m_sector_users")
}

model M1MCustomer {
  id            String    @id @default(cuid())
  companyId     String
  customerCode  Int?
  remoteJid     String    @unique
  name          String?
  phone         String?
  company       String?
  city          String?
  responsible   String?
  responsibleId String?
  observations  String?
  status        String?   @default("IA")
  assignedAt    DateTime?
  releasedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  owner           M1MCompany          @relation(fields: [companyId], references: [id])
  assignedUser    M1MUser?            @relation("AssignedCustomerUser", fields: [responsibleId], references: [id], onDelete: SetNull)
  reminders       M1MReminder[]
  attendances     M1MAttendance[]
  messages        M1MMessage[]
  paymentReceipts M1MPaymentReceipt[]

  @@unique([companyId, customerCode])
  @@index([companyId])
  @@index([remoteJid])
  @@index([responsibleId])
  @@index([status])
  @@map("m1m_customers")
}

model M1MReminder {
  id          String    @id @default(cuid())
  companyId   String
  customerId  String
  title       String
  description String?
  remindAt    DateTime
  responsible String?
  status      String    @default("PENDING")
  completedAt DateTime?
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company  M1MCompany  @relation(fields: [companyId], references: [id])
  customer M1MCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([customerId])
  @@index([remindAt])
  @@index([status])
  @@map("m1m_reminders")
}

model M1MAttendance {
  id            String             @id @default(cuid())
  number        Int                @unique @default(autoincrement())
  companyId     String
  customerId    String
  responsibleId String?
  sectorId      String?
  state         M1MAttendanceState @default(IA)
  startedAt     DateTime           @default(now())
  assignedAt    DateTime?
  finishedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  company         M1MCompany           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer        M1MCustomer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  responsible     M1MUser?             @relation("AttendanceResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  sector          M1MSector?           @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  events          M1MAttendanceEvent[]
  messages        M1MMessage[]
  paymentReceipts M1MPaymentReceipt[]

  @@index([companyId])
  @@index([customerId])
  @@index([responsibleId])
  @@index([sectorId])
  @@index([state])
  @@index([startedAt])
  @@index([finishedAt])
  @@index([companyId, customerId])
  @@map("m1m_attendances")
}

model M1MAttendanceEvent {
  id           String                 @id @default(cuid())
  attendanceId String
  type         M1MAttendanceEventType
  actorType    M1MAttendanceActorType
  actorId      String?
  metadata     Json?
  createdAt    DateTime               @default(now())

  attendance M1MAttendance @relation(fields: [attendanceId], references: [id], onDelete: Restrict)
  actor      M1MUser?      @relation("AttendanceEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([attendanceId])
  @@index([type])
  @@index([actorId])
  @@index([createdAt])
  @@map("m1m_attendance_events")
}

enum M1MMessageAuthorType {
  CUSTOMER
  HUMAN
  AI
}

model M1MMessage {
  id                 String                @id @default(cuid())
  companyId          String
  customerId         String
  attendanceId       String?
  instanceName       String
  evolutionMessageId String
  remoteJid          String
  direction          M1MMessageDirection
  type               M1MMessageType
  fromMe             Boolean
  authorType         M1MMessageAuthorType?
  authorId           String?
  authorName         String?
  content            String?
  mediaUrl           String?
  mimeType           String?
  rawPayload         Json?
  sentAt             DateTime
  processingStartedAt DateTime?
  processedAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  company        M1MCompany         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer       M1MCustomer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  attendance     M1MAttendance?     @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  paymentReceipt M1MPaymentReceipt?
  flags          M1MMessageFlag[]

  @@unique([companyId, instanceName, evolutionMessageId])
  @@index([companyId])
  @@index([customerId])
  @@index([attendanceId])
  @@index([remoteJid])
  @@index([direction])
  @@index([authorType])
  @@index([authorId])
  @@index([type])
  @@index([sentAt])
  @@index([processingStartedAt])
  @@index([processedAt])
  @@index([companyId, remoteJid, sentAt])
  @@map("m1m_messages")
}

model M1MMessageFlag {
  id        String             @id @default(cuid())
  companyId String
  messageId String
  type      M1MMessageFlagType
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  company M1MCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  message M1MMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([companyId, messageId, type])
  @@index([companyId])
  @@index([messageId])
  @@index([type])
  @@index([companyId, type, createdAt])
  @@map("m1m_message_flags")
}

model M1MPaymentReceipt {
  id                 String                  @id @default(cuid())
  companyId          String
  customerId         String
  attendanceId       String?
  messageId          String?                 @unique
  responsibleId      String?
  status             M1MPaymentReceiptStatus @default(RECEIVED)
  mediaUrl           String?
  mimeType           String?
  fileName           String?
  amount             Decimal?                @db.Decimal(14, 2)
  paymentMethod      String?
  identifiedBank     String?
  paidAt             DateTime?
  observations       String?
  rejectionReason    String?
  classifiedAt       DateTime?
  reviewStartedAt    DateTime?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  customerNotifiedAt DateTime?
  finishedAt         DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  company     M1MCompany               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer    M1MCustomer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  attendance  M1MAttendance?           @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  message     M1MMessage?              @relation(fields: [messageId], references: [id], onDelete: SetNull)
  responsible M1MUser?                 @relation("PaymentReceiptResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  events      M1MPaymentReceiptEvent[]

  @@index([companyId])
  @@index([customerId])
  @@index([attendanceId])
  @@index([responsibleId])
  @@index([status])
  @@index([createdAt])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@map("m1m_payment_receipts")
}

model M1MPaymentReceiptEvent {
  id        String                     @id @default(cuid())
  receiptId String
  type      M1MPaymentReceiptEventType
  actorType M1MAttendanceActorType
  actorId   String?
  metadata  Json?
  createdAt DateTime                   @default(now())

  receipt M1MPaymentReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  actor   M1MUser?          @relation("PaymentReceiptEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([receiptId])
  @@index([type])
  @@index([actorId])
  @@index([createdAt])
  @@map("m1m_payment_receipt_events")
}

model M1MSubscriptionEvent {
  id                   String                   @id @default(cuid())
  companyId            String
  type                 M1MSubscriptionEventType
  planName             String?
  amountCents          Int?
  billingCycle         M1MBillingCycle?
  previousAccessEndsAt DateTime?
  newAccessEndsAt      DateTime?
  createdAt            DateTime                 @default(now())

  company M1MCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  payments M1MSubscriptionPayment[]

  @@index([companyId, createdAt])
  @@map("m1m_subscription_events")
}

model M1MSubscriptionPayment {
  id                  String   @id @default(cuid())
  companyId           String
  subscriptionEventId String?
  amountCents         Int
  paidAt              DateTime
  paymentMethod       String?
  notes               String?
  createdAt           DateTime @default(now())

  company           M1MCompany            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscriptionEvent M1MSubscriptionEvent? @relation(fields: [subscriptionEventId], references: [id], onDelete: SetNull)

  @@index([companyId, paidAt])
  @@index([subscriptionEventId])
  @@map("m1m_subscription_payments")
}
