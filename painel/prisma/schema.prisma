generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum M1MAttendanceState {
  IA
  HUMANO
  FINALIZADO
}

enum M1MAttendanceEventType {
  STARTED_BY_AI
  TAKEN_BY_HUMAN
  FINISHED_BY_HUMAN
  FINISHED_BY_AI
}

enum M1MAttendanceActorType {
  AI
  USER
  SYSTEM
}

model M1MCompany {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       M1MUser[]
  customers   M1MCustomer[]
  reminders   M1MReminder[]
  attendances M1MAttendance[]

  @@map("m1m_companies")
}

model M1MUser {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  displayName String?
  email       String   @unique
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company             M1MCompany           @relation(fields: [companyId], references: [id])
  assignedCustomers   M1MCustomer[]        @relation("AssignedCustomerUser")
  assignedAttendances M1MAttendance[]      @relation("AttendanceResponsible")
  attendanceEvents    M1MAttendanceEvent[] @relation("AttendanceEventActor")

  @@index([companyId])
  @@map("m1m_users")
}

model M1MCustomer {
  id            String    @id @default(cuid())
  companyId     String
  remoteJid     String    @unique
  name          String?
  phone         String?
  company       String?
  city          String?
  responsible   String?
  responsibleId String?
  observations  String?
  status        String?   @default("IA")
  assignedAt    DateTime?
  releasedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  owner        M1MCompany      @relation(fields: [companyId], references: [id])
  assignedUser M1MUser?        @relation("AssignedCustomerUser", fields: [responsibleId], references: [id], onDelete: SetNull)
  reminders    M1MReminder[]
  attendances  M1MAttendance[]

  @@index([companyId])
  @@index([remoteJid])
  @@index([responsibleId])
  @@index([status])
  @@map("m1m_customers")
}

model M1MReminder {
  id          String    @id @default(cuid())
  companyId   String
  customerId  String
  title       String
  description String?
  remindAt    DateTime
  responsible String?
  status      String    @default("PENDING")
  completedAt DateTime?
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company  M1MCompany  @relation(fields: [companyId], references: [id])
  customer M1MCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([customerId])
  @@index([remindAt])
  @@index([status])
  @@map("m1m_reminders")
}

model M1MAttendance {
  id            String             @id @default(cuid())
  number        Int                @unique @default(autoincrement())
  companyId     String
  customerId    String
  responsibleId String?
  state         M1MAttendanceState @default(IA)
  startedAt     DateTime           @default(now())
  assignedAt    DateTime?
  finishedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  company     M1MCompany           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer    M1MCustomer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  responsible M1MUser?             @relation("AttendanceResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  events      M1MAttendanceEvent[]

  @@index([companyId])
  @@index([customerId])
  @@index([responsibleId])
  @@index([state])
  @@index([startedAt])
  @@index([finishedAt])
  @@index([companyId, customerId])
  @@map("m1m_attendances")
}

model M1MAttendanceEvent {
  id           String                 @id @default(cuid())
  attendanceId String
  type         M1MAttendanceEventType
  actorType    M1MAttendanceActorType
  actorId      String?
  metadata     Json?
  createdAt    DateTime               @default(now())

  attendance M1MAttendance @relation(fields: [attendanceId], references: [id], onDelete: Restrict)
  actor      M1MUser?      @relation("AttendanceEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([attendanceId])
  @@index([type])
  @@index([actorId])
  @@index([createdAt])
  @@map("m1m_attendance_events")
}
